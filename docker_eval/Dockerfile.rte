FROM python:3.11-slim

### User args, these have to be after the FROM
ARG REPO_TAG__REGION_MGR="development"
ARG REPO_TAG__EVAL_MGR="development"
ARG REPO_TAG__VERF_MGR="development"

### Static args
ARG PYTHON_ENV="/ngen-app/ngen-python/bin"
ARG GITHUB_ORG_URL="https://github.com/NGWPC"
ARG GITHUBUSERCONTENT_ORG_URL="https://raw.githubusercontent.com/NGWPC"
ARG REPO_NAME__REGION_MGR="nwm-region-mgr"
ARG REPO_NAME__EVAL_MGR="nwm-eval-mgr"
ARG REPO_NAME__VERF_MGR="nwm-verf"
ARG PYTHON_VERSION_STR="python3.11"

### Activate the venv
ENV PATH="${PYTHON_ENV}:${PATH}"
RUN pip install --upgrade pip

# Install git and build-essential
RUN apt-get update && apt-get install -y git build-essential && rm -rf /var/lib/apt/lists/*

# Install curl (used to download files from GitHub)
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# For netCDF support
RUN apt-get update && apt-get install -y libhdf5-dev libnetcdf-dev && rm -rf /var/lib/apt/lists/*

##############################
####  nmw-verf & nwm-eval-mgr

## From GitHub
RUN pip install "nwm.eval @ git+${GITHUB_ORG_URL}/${REPO_NAME__EVAL_MGR}@${REPO_TAG__EVAL_MGR}"
RUN pip install "nwm.verf @ git+${GITHUB_ORG_URL}/${REPO_NAME__VERF_MGR}@${REPO_TAG__VERF_MGR}"

## From local (TODO)


### Sample EVAL config files 
## From GitHub
RUN mkdir -p "/ngen-app/${REPO_NAME__REGION_MGR}/configs/"
RUN curl -L https://raw.githubusercontent.com/NGWPC/${REPO_NAME__REGION_MGR}/${REPO_TAG__REGION_MGR}/configs/config_eval.yaml \
    -o /ngen-app/${REPO_NAME__REGION_MGR}/configs/config_eval.yaml

## From local
#COPY configs/config_eval.yaml /ngen-app/nwm-region-mgr/configs/config_eval.yaml
